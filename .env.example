# ============================================================
# Order Processing System - Environment Variables
# Copy this file to .env for local overrides, or set these
# in Google Cloud Run for production deployment.
# ============================================================

# 1. Server Port (Google Cloud Run sets PORT automatically)
PORT=8080

# 2. Database Configuration (Local Docker OR Neon PostgreSQL)
# Option A: Individual fields (set DB_SSLMODE=require for Neon)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orders_db
DB_USER=postgres
DB_PASS=Pratham@9304
DB_SSLMODE=prefer
# Option B: Or provide full JDBC URL directly (overrides DB_HOST/DB_PORT/DB_NAME):
# DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech:5432/neondb?sslmode=require

# 3. Kafka Configuration (Local Docker OR Managed Cloud Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# For Managed Kafka (Confluent Cloud / Redpanda Cloud / Aiven):
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_USERNAME=your-kafka-api-key-or-username
# KAFKA_PASSWORD=your-kafka-api-secret-or-password

# 4. CORS Allowed Origins (Comma-separated list; supports wildcard patterns)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# 5. JWT Configuration
JWT_SECRET=OrderFlowSuperSecretKeyForJwtSigning2026!@#
JWT_EXPIRATION_SECONDS=86400
